# ── LLM ──────────────────────────────────────────────────────────────────────
# Primary provider: "groq" (default) or "gemini"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq key → https://console.groq.com/keys
GROQ_API_KEY=<your Groq key>

# Gemini key (used as fallback when Groq fails, or as primary if LLM_PROVIDER=gemini)
GEMINI_API_KEY=<your Gemini key>
GEMINI_MODEL=gemini-2.0-flash

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_MODE=server
QDRANT_URL=https://<your-cluster>.cloud.qdrant.io
QDRANT_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# fastembed ONNX model — 384-dim, no PyTorch, ~40 MB download on first run
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=/tmp/fastembed_cache

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:3000

# ── Infra ─────────────────────────────────────────────────────────────────────
RERANK_ENABLED=false
OMP_NUM_THREADS=1
WEB_CONCURRENCY=1
UPLOAD_DIR=/tmp/uploads
PYTHON_VERSION=3.11.9
